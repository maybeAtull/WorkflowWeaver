# .env.example — copy to .env and fill in your credentials.
# Never commit .env. Use synthetic/test data only.

# --- LLM ---
LLM_API_KEY=your_llm_api_key_here
# Optional: model id used for planning and content generation (default shown)
LLM_MODEL=claude-sonnet-5-5

# --- Notion (MCP) ---
NOTION_TOKEN=your_notion_integration_token
NOTION_PAGE_ID=your_target_notion_page_id

# --- Google Drive (MCP) ---
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id

# --- Microsoft Teams (Workflows / Incoming Webhook) ---
TEAMS_WEBHOOK_URL=your_teams_webhook_url

# --- Langfuse ---
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Testing aid (optional) ---
# Set to a step id to force that step to fail, to demo retry and rollback. Leave empty normally.
SIMULATE_FAILURE_STEP=
