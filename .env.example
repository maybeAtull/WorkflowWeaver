# .env.example — copy to .env and fill in your credentials.
# Never commit .env. Use synthetic/test data only.

# --- LLM ---
# Which provider your key belongs to: google (Gemini), groq (Groq) or anthropic (Claude)
LLM_PROVIDER=google
LLM_API_KEY=your_llm_api_key_here
# Optional: model id. Leave empty for the provider default
# (google: gemini-3.8-flash, groq: openai/gpt-oss-120b, anthropic: claude-sonnet-5-5).
# Model names change over time:
# if you get a "model not found" error, set this to a current model from your provider's list.
LLM_MODEL=

# --- Notion (MCP) ---
NOTION_TOKEN=your_notion_integration_token
NOTION_PAGE_ID=your_target_notion_page_id

# --- Google Drive (MCP) ---
# OAuth client JSON (Desktop app) downloaded from Google Cloud. Relative to the project root.
GOOGLE_CREDENTIALS_PATH=credentials.json
# The id at the end of your Drive folder's URL
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here
# Optional: folder containing tokens.json from the one-time login
# (npx -y @piotr-agier/google-drive-mcp@2.13.0 auth). Leave empty for the default,
# ~/.config/google-drive-mcp
GOOGLE_TOKEN_DIR=

# --- Notifications (final workflow step) ---
# Which chat tool receives the summary: slack or teams. Only the matching URL below is required.
NOTIFIER_PROVIDER=teams
# Slack: Incoming Webhook URL (https://hooks.slack.com/services/...)
SLACK_WEBHOOK_URL=your_slack_incoming_webhook_url
# Microsoft Teams: Workflows / Incoming Webhook URL
TEAMS_WEBHOOK_URL=your_teams_webhook_url

# --- Langfuse ---
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Run history (optional) ---
# SQLite file that stores past runs. A relative path is relative to backend/. Created on first start.
DATABASE_PATH=data/workflowweaver.db

# --- Testing aid (optional) ---
# Set to a step id to force that step to fail, to demo retry and rollback. Leave empty normally.
SIMULATE_FAILURE_STEP=
